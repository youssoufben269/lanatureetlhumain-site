# Variables d’environnement du processus serveur ; ce fichier n’est pas chargé automatiquement.
LNH_MODULE_ORIGIN=https://adhesions.lanatureetlhumain.org
LNH_WEBSITE_URL=https://www.lanatureetlhumain.org
LNH_ALLOWED_ORIGINS=https://www.lanatureetlhumain.org
# Stockage hors racine publique, disque persistant, accès limité au compte de service.
LNH_DATA_DIR=/srv/lnh-private
# Définir les catégories prévues par les statuts avant ouverture au public.
LNH_CATEGORIES=actif,sympathisant,institutionnel
# À renseigner selon le droit réellement adopté. Aucun montant réel n’est présumé.
# En centimes pour EUR ; en francs entiers pour KMF.
LNH_FEE_MINOR=
LNH_CURRENCY=EUR
LNH_VALIDITY_MONTHS=12
LNH_TIMEZONE=Indian/Comoro
LNH_QR_MODE=website
LNH_PUBLIC_VERIFICATION=0
LNH_PRIVACY_CONTACT=contact@lanatureetlhumain.org
LNH_RETENTION_DAYS=90
# Signature autorisée de l’association, fichier serveur privé (facultatif).
LNH_SIGNATURE_PATH=
# Emails : désactivés tant que HOST est vide. Pas de service payant imposé.
LNH_SMTP_HOST=
LNH_SMTP_PORT=465
LNH_SMTP_SECURITY=ssl
LNH_SMTP_FROM=contact@lanatureetlhumain.org
LNH_SMTP_USER=
LNH_SMTP_PASSWORD=
# Seulement derrière le proxy local contrôlé, jamais une IP publique générique.
LNH_TRUSTED_PROXY=
# Profil gratuit : PostgreSQL pooler Session (5432), bucket Supabase privé.
# La chaîne de connexion et la clé serveur sont des secrets, jamais dans Git.
LNH_DATABASE_URL=
LNH_STORAGE_BACKEND=local
LNH_SUPABASE_URL=
LNH_SUPABASE_SERVICE_KEY=
LNH_STORAGE_BUCKET=lnh-private
LNH_REQUIRE_REMOTE_STORAGE=0
# Création du premier administrateur au démarrage, sans shell distant.
# Effacer le mot de passe de l'environnement après la première création.
LNH_BOOTSTRAP_ADMIN_EMAIL=
LNH_BOOTSTRAP_ADMIN_PASSWORD=
